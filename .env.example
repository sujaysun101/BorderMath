# Clerk authentication. Leave unset in local dev to use Clerk keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Postgres (Neon or Supabase). When unset, the app uses an in-memory demo store.
DATABASE_URL=

# Server-side model calls only. When unset, briefs are labeled samples.
ANTHROPIC_API_KEY=
AI_MODEL=

# Optional Upstash rate limit for the brief endpoint. Otherwise an in-memory bucket is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to 1 only while capturing portfolio screenshots. Enables /demo without auth.
DEMO_SCREENSHOT=

# Optional user id for `npm run db:seed` when DATABASE_URL is set.
SEED_USER_ID=
